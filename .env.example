# ==============================================================================
# Lumberfi Commission Platform — Backend Environment Configuration Example
# Copy this file to .env for local development, or configure these in Render.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# MongoDB Atlas connection URI (e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/lumberfi?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# Secret key used for signing JWT access tokens (generate with `openssl rand -hex 32`)
JWT_SECRET=your-random-secret-key-change-this-in-production

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT access token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo password for seeded initial users (default: demo123)
DEFAULT_DEMO_PASSWORD=demo123

# Comma-separated allowed frontend origins for CORS (e.g., Render Static Site URL)
# Localhost dev origins (5173, 5174, 3000) are automatically permitted in addition to these.
CORS_ORIGINS=https://your-frontend.onrender.com
