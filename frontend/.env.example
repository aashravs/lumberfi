# ==============================================================================
# Lumberfi Commission Platform — Frontend Environment Configuration Example
# In local development, leaving this unset uses the Vite dev server proxy (/api -> http://127.0.0.1:8000).
# On Render Static Site, set this to your Render backend web service URL.
# ==============================================================================

# Backend API base URL (omit trailing slash)
# Example for Render production:
VITE_API_URL=https://your-backend.onrender.com
